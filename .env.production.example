# ==============================================================================
# ARTYX DIGITAL ERP — PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# ==============================================================================
# Copy this file to .env.production or paste into your cloud hosting dashboard
# (Vercel, Railway, Render, Fly.io, AWS, DigitalOcean).
# ==============================================================================

NODE_ENV="production"

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Neon / Supabase / RDS)
# ------------------------------------------------------------------------------
# Primary pooled database connection string (with ?sslmode=require)
DATABASE_URL="postgresql://user:password@pooler-host.neon.tech/neondb?sslmode=require"

# Direct unpooled connection string (required for Prisma db push & migrations)
DIRECT_URL="postgresql://user:password@direct-host.neon.tech/neondb?sslmode=require"

# Connection pool limit per instance (5 for serverless, 10-20 for Docker/VPS)
DATABASE_POOL_MAX=10

# ------------------------------------------------------------------------------
# 2. NEXTAUTH / AUTH.JS SECURITY
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32  or  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-64-character-random-hex-string"
NEXTAUTH_SECRET="replace-with-a-64-character-random-hex-string"

# Canonical production application domain (HTTPS required)
AUTH_URL="https://office.artyx.digital"
NEXTAUTH_URL="https://office.artyx.digital"
NEXT_PUBLIC_APP_URL="https://office.artyx.digital"

# Session Expiry (in seconds)
AUTH_SESSION_MAX_AGE_SECONDS=2592000
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=86400

# ------------------------------------------------------------------------------
# 3. REAL-TIME TEAM CHAT (SOCKET.IO)
# ------------------------------------------------------------------------------
SOCKET_PORT=3001
NEXT_PUBLIC_SOCKET_URL="https://office.artyx.digital:3001"

# ------------------------------------------------------------------------------
# 4. REGIONAL & PERFORMANCE SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_TIMEZONE="Asia/Dhaka"
DATA_CACHE_TTL_MS=15000

# Agency Branding
NEXT_PUBLIC_POS_OUTLET_NAME="Artyx Digital HQ"
NEXT_PUBLIC_POS_WEBSITE_URL="https://artyx.digital"
NEXT_PUBLIC_POS_GMAIL_URL="https://mail.google.com/"
NEXT_PUBLIC_POS_FACEBOOK_URL="https://facebook.com/artyxdigital"
NEXT_PUBLIC_POS_INSTAGRAM_URL="https://www.instagram.com/artyxdigital"

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL / SMTP [OPTIONAL]
# ------------------------------------------------------------------------------
# SMTP_HOST="smtp.mailgun.org"
# SMTP_PORT=587
# SMTP_USER="postmaster@mg.artyx.digital"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="Artyx Digital <notifications@artyxdigital.com>"

# ------------------------------------------------------------------------------
# 6. WEB PUSH NOTIFICATIONS (VAPID) [OPTIONAL]
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:admin@artyxdigital.com"

# ------------------------------------------------------------------------------
# 7. SMS / TWILIO [OPTIONAL]
# ------------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""
# TWILIO_WHATSAPP_FROM=""
