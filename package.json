{
  "name": "artyx-office",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 --turbopack",
    "dev:full": "pnpm db:generate && next dev -H 0.0.0.0 --turbopack",
    "build": "prisma generate && cross-env NODE_OPTIONS=--max-old-space-size=2048 next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "test": "vitest run",
    "postinstall": "prisma generate && node scripts/fix-prisma-client-path.mjs",
    "lint": "eslint",
    "db:generate": "prisma generate && node scripts/fix-prisma-client-path.mjs",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "tsx scripts/reset-database.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
